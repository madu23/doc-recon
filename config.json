{
  "excel": {
    "header_row": 2,
    "columns": {
      "serial": "S/N",
      "first_name": "FIRST_NAME",
      "last_name": "LAST_NAME",
      "phone": "MOBILE",
      "address": "STREET",
      "location": "CITY",
      "pod_number": "POD number"
    }
  },
  "validation": {
    "name_match_threshold": 88,
    "address_match_threshold": 72,
    "reference_min_length": 12,
    "require_reference_inside_pod": true,
    "name_fallback_requires_phone_and_address": true,
    "review_on_low_ocr_confidence": true
    ,"minimum_ocr_confidence": 35
  },
  "ocr": {
    "psm_modes": [3, 11],
    "upscale": 1.5,
    "language": "eng",
    "tesseract_cmd": ""
  },
  "files": {
    "accepted_prefix_from_excel_serial": true,
    "copy_instead_of_move": true,
    "supported_extensions": [".jpg", ".jpeg", ".png", ".tif", ".tiff", ".bmp"]
  }
}
